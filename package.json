{
  "name": "tnp-defect-management-dev",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "npm run build:server && node dist-server/server/index.js",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/finalize-server-build.mjs",
    "start": "npm run build:server && node dist-server/server/index.js",
    "start:lan": "npm run build:server && node dist-server/server/index.js --lan",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run tests/server",
    "migrate:indexeddb": "npm run build:server && node dist-server/server/migrateIndexedDb.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
